# ============================================================
# 知微 ZhiWei · 环境变量模板
# 复制为 .env 后填写。切勿把真实 .env 提交到仓库。
# ============================================================

# --- 大模型网关（OpenAI 兼容，例如阿里云百炼 / DashScope 兼容模式） ---
ZHIWEI_API_KEY=sk-your-key-here
ZHIWEI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 模型选型（可按额度替换） ---
# 深度推理 / 复杂编排
ZHIWEI_MODEL=qwen3.7-plus
# 高频轻量调用（检索改写、路由、抽取）
ZHIWEI_FAST_MODEL=qwen3.8-flash
# 视觉 OCR（扫描件、图表、公式）
ZHIWEI_VL_MODEL=qwen-vl-ocr
# 向量化
ZHIWEI_EMBED_MODEL=qwen3.7-text-embedding-flash
# 重排
ZHIWEI_RERANK_MODEL=qwen3.7-text-rerank
# 学术翻译
ZHIWEI_TRANSLATE_MODEL=qwen-mt-uni

# --- 外部学术数据源 ---
# OpenAlex / Semantic Scholar 均为公开接口，邮箱用于礼貌标识
ZHIWEI_CONTACT_EMAIL=you@example.com
SEMANTIC_SCHOLAR_API_KEY=

# --- GitHub 复现性检查（可选） ---
GITHUB_TOKEN=

# --- 反射弧闸门（可选：接入真 Jev 时填写） ---
JEV_API_KEY=
REFLEX_CLIENT=local

# --- 主张闸门阈值（可选，不填就用代码默认的 0.35 / 0.75） ---
# 综合分 < BLOCK_AT 直接拦下；>= ALLOW_AT 放行；中间降级为「待核实」。
# 评测集标定的最优组合是 BLOCK_AT=0.20 / ALLOW_AT=0.85（见 evals/report.md）。
# 这两行默认注释掉：想要标定最优就取消注释，想更保守就把 ALLOW_AT 继续往上抬。
#ZHIWEI_GATE_BLOCK_AT=0.20
#ZHIWEI_GATE_ALLOW_AT=0.85

# --- 运行参数 ---
ZHIWEI_DATA_DIR=./data
ZHIWEI_HOST=127.0.0.1
ZHIWEI_PORT=8000
# 百页长文档的内存门槛（页）
ZHIWEI_LONG_DOC_PAGE_THRESHOLD=100
# 检索返回条数
ZHIWEI_TOP_K=8
